{
  "compilerOptions": {
    "strictNullChecks": true,
    "types": ["node"],
    "checkJs": true,
    "strict": true,
    "alwaysStrict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["./src/**/*"]
}
