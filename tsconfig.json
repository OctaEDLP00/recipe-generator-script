{
  "compilerOptions": {
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "alwaysStrict": true,
    "module": "nodenext",
    "target": "esnext",
    "paths": {
      "~/*": [ "./src/*" ]
    }
  },
  "include": ["./src/*"],
  "exclude": ["./src/jsdoc.d.mjs"]
}
